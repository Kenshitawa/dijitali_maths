{
  "name": "dijitali-maths",
  "version": "2.0.0",
  "description": "Dijitali Maths NGO website, API, and admin portal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:pages": "tsx scripts/build-pages.ts",
    "build": "npm run build:pages && npm run build:admin && tsc",
    "build:admin": "vite build --config vite.admin.config.js",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate:pg": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:migrate:pg": "prisma migrate deploy --schema=prisma/schema.postgresql.prisma",
    "check:production-env": "node scripts/check-production-env.mjs",
    "deploy:cpanel": "node scripts/deploy-cpanel.mjs",
    "seed": "tsx prisma/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "migrate-images": "tsx scripts/migrate-images.ts",
    "cleanup:demo": "tsx scripts/cleanup-demo-data.ts",
    "test": "vitest run tests/unit.test.ts tests/api.test.ts",
    "test:e2e": "playwright test",
    "check:links": "tsx scripts/check-links.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.6.1",
    "sanitize-html": "2.17.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.47",
    "@ai-sdk/google": "^4.0.61",
    "@ai-sdk/openai": "^4.0.53",
    "@ai-sdk/react": "^4.0.90",
    "@eslint/js": "^9.22.0",
    "@internationalized/date": "^3.12.1",
    "@playwright/test": "^1.51.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-table": "^8.21.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "ai": "^7.0.87",
    "eslint": "^9.22.0",
    "motion": "^12.42.2",
    "prisma": "^6.5.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.9.2",
    "supertest": "^7.0.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^7.3.8",
    "vitest": "^5.1.2"
  }
}

