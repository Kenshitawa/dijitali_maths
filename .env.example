# ==============================================================================
# Dijitali Maths — Environment Variables
# Copy this file to .env and fill in real values before running in production.
# ==============================================================================

# Server
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
SITE_URL=https://dijitalimaths.org

# Database
# Local development uses SQLite by default:
DATABASE_URL="file:./dev.db"
# Production Supabase example: use the session pooler on port 5432 for a
# persistent Node.js app when the cPanel host is IPv4-only. Keep credentials
# in cPanel's environment settings; never commit them in this file.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Security & Sessions (REQUIRED: generate random 32+ char strings in production)
SESSION_SECRET=change-this-to-a-long-random-secret-in-production-at-least-32-chars
ANALYTICS_SALT_SECRET=change-this-to-another-random-secret-for-daily-ip-hashing
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=10

# Uploads
UPLOAD_DIR=uploads
# A little under 4.5 MB leaves room for multipart form data on Vercel.
MAX_UPLOAD_FILE_MB=4.25
MAX_UPLOAD_FILES=20

# Safaricom Daraja STK Push (configure with credentials for the selected environment).
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=

# Email / SMTP (required by the production startup check; optional in development)
# Optional: leave SMTP values blank to keep form submissions without email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dijitali Maths <dijitalimaths@gmail.com>"
NOTIFY_EMAIL=dijitalimaths@gmail.com
